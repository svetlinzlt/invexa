# Копирай този файл като .env.local и попълни стойностите.
# .env.local никога не влиза в git.

# От Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ВНИМАНИЕ: service_role ключът заобикаля всички правила за достъп.
# Стои само на сървъра. Никога не го давай на префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
