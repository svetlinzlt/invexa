<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Часовникът е отделно устройство и не вижда App Group-а на телефона.
	     Данните идват през същия iCloud контейнер — това е мостът между
	     двете устройства и причината CloudKit да бъде избран в началото. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.invexa</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>

	<!-- Групата е локална за часовника: приложението и усложнението му
	     споделят една база. Името съвпада с това на телефона, но
	     контейнерът е различен. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.invexa</string>
	</array>
</dict>
</plist>
